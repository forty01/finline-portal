// NOTE: The live rules published in the Firebase Console (project: gen-lang-client-0937767860)
// additionally contain the SinglePeaches app's rule blocks, which are managed directly in the
// Firebase Console and must NOT be removed from there. This file tracks only the FIN-Line
// portal's Firestore rule blocks.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public intake: anyone with the link can CREATE a submission
    match /submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'fortysinbox@gmail.com';
    }
    // Advisors: full access to their own advisor docs
    match /advisors/{advisorId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'fortysinbox@gmail.com';
    }
    // Client resume drafts: get-by-unguessable-token ONLY; listing all drafts is strictly denied.
    // Drafts are kept separate from submissions and never appear in the advisor inbox.
    match /drafts/{draftToken} {
      allow get: if draftToken.size() >= 32;
      allow list: if false;
      allow create, update: if draftToken.size() >= 32;
      allow delete: if draftToken.size() >= 32 || (request.auth != null && request.auth.token.email == 'fortysinbox@gmail.com');
    }
    // Firebase Trigger Email extension queue (firebase/firestore-send-email)
    // Clients can enqueue notification/resume emails; only the advisor can read mail status.
    match /mail/{mailId} {
      allow create: if request.resource.data.keys().hasAll(['to', 'message'])
                    && request.resource.data.to is list
                    && request.resource.data.to.size() == 1
                    && request.resource.data.message.keys().hasAll(['subject', 'text']);
      allow read: if request.auth != null && request.auth.token.email == 'fortysinbox@gmail.com';
      allow update, delete: if false;
    }
  }
}
